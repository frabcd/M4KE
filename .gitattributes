# Keep source portable without touching working files during this reorganization.
* text=auto
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Native assets and media must not receive text conversion.
*.stl binary
*.step binary
*.stp binary
*.3mf binary
*.glb binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp4 binary
*.pdf binary
*.docx binary
*.zip binary
*.gz binary
