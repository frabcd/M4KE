# Optional local inference. Leave blank until DGX is available. No cloud fallback.
OLLAMA_URL=
# Protocol: ollama (default) or vllm. OLLAMA_URL remains the local base URL for
# both for compatibility; vLLM uses /v1/models and /v1/chat/completions internally.
# This does not launch a service or select/download a model.
M4KE_INFERENCE_PROVIDER=
QWEN_MODEL=
PORT=4173

# Optional component-source web search. Default 0: cache only, no web requests.
# Run your own SearXNG service on DGX loopback with JSON search enabled.
# Queries send component identity only; no project upload, auto-purchase or CAD adoption.
M4KE_ALLOW_WEB=
M4KE_SEARCH_URL=
# Optional bounded engine selection; availability depends on local connectivity.
M4KE_SEARCH_ENGINES=
